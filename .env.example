# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (Project URL and Publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Connect → "Session pooler" connection string (used only by `npm run db:migrate`)
DATABASE_URL=

# OpenAI → API keys
OPENAI_API_KEY=
# Optional: which model writes the content, and how hard it thinks.
# gpt-6-sol is the balanced default; gpt-6-astra is the flagship (~5x the cost).
OPENAI_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=medium

# Optional: public URL of the app, used in login emails (defaults to the request's own URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
