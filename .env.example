# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API Keys (Project URL and Secret key).
# Older projects show a "service_role" key instead; SUPABASE_SERVICE_ROLE_KEY works too.
# The secret key is only read on the server. There is no login: anyone with the
# app's URL can use it and sees the same workspace.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase → Connect → "Session pooler" connection string (used only by `npm run db:migrate`)
DATABASE_URL=

# OpenAI → API keys
OPENAI_API_KEY=
# Optional: which model writes the content, and how hard it thinks.
# gpt-6-sol is the balanced default; gpt-6-astra is the flagship (~5x the cost).
OPENAI_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=medium
# Optional: the model that draws Reel images, and their quality (low, medium, high).
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Optional: Sales → Find leads. Vibe Prospecting runs on Explorium's API;
# get the key from the "Free API Key" button at explorium.ai (or admin.explorium.ai).
EXPLORIUM_API_KEY=
